syntax = "proto3";

package {{.ServiceDirectory}}.v1;

import "buf/validate/validate.proto";
import "google/api/annotations.proto";

option go_package = "{{.ModulePath}}/gen/go/{{.ServiceDirectory}}/v1;servicev1";

// {{.ServiceName}} is an application-owned API contract.
service {{.ServiceName}} {
  // Get retrieves a resource by ID. Replace this baseline operation as needed.
  rpc Get(GetRequest) returns (GetResponse) {
    option (google.api.http) = {get: "/v1/{{.ServiceDirectory}}/{id}"};
  }
}

// GetRequest identifies a resource.
message GetRequest {
  string id = 1 [(buf.validate.field).string.min_len = 1];
}

// GetResponse contains the resource identifier.
message GetResponse {
  string id = 1;
}
